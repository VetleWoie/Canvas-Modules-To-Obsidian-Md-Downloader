CANVAS_URL=https://school.instructure.com

# Use ONE of the two auth methods below.

# Option 1: API token (Account -> Settings -> New access token)
CANVAS_TOKEN=your-api-token-here

# Option 2: if you don't have permission to generate an API token, use your
# browser's session cookie instead:
#   1. Log into Canvas in your browser.
#   2. Open DevTools (F12) -> Network tab, reload the page.
#   3. Click any request to your Canvas domain, find "Cookie" under Request Headers.
#   4. Copy the whole value (starts with something like "_csrf_token=...; ...") here.
# CANVAS_COOKIE=paste the full Cookie header value here

# Note: session cookies expire (Canvas sessions typically last a few hours to a
# day of inactivity). If a run fails partway through with an auth error, grab a
# fresh cookie and rerun.
